# Token fields are shown publicly on the page. Leave TOKEN_MINT blank until the
# official Solana mint has been deployed and independently verified.
COIN_NAME=Juicy Couture Coin
COIN_SYMBOL=JCQ
COIN_NETWORK=Solana
TOKEN_MINT=
COMMUNITY_URL=

# Video rooms work without credentials or a separate media server.
MAX_ROOM_PARTICIPANTS=8

# Optional payment network. Defaults to Solana mainnet; no API key is required.
SOLANA_CLUSTER=mainnet-beta
# Optional HTTPS RPC override; leave blank to use the public endpoint.
SOLANA_RPC_URL=
