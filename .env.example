# Token fields are shown publicly on the page. Leave TOKEN_MINT blank until the
# official Solana mint has been deployed and independently verified.
COIN_NAME=Juicy Couture Coin
COIN_SYMBOL=JCQ
COIN_NETWORK=Solana
TOKEN_MINT=
COMMUNITY_URL=

# Voluntary stream tips: an existing standard SPL token and a public receiving
# wallet (never a private key). Blank values keep payments disabled.
STREAM_WALLET_ADDRESS=
# mainnet-beta or devnet; the mint and wallet must belong to the selected cluster.
SOLANA_CLUSTER=mainnet-beta
# Optional server-side HTTPS RPC endpoint. Leave blank for the public cluster RPC.
SOLANA_RPC_URL=

# Server-only Jupiter API key for mainnet swaps. Never put it in browser code.
JUPITER_API_KEY=
# Persistent storage for the community SQLite database and sanitized photos.
# Local default: .data/community; production must use a mounted persistent disk.
MEDIA_DATA_DIR=.data/community
# Public wallet addresses allowed to approve and fund reward drops, comma-separated.
# Payouts are signed by these hosts in their own wallets; no private key goes here.
REWARD_HOST_WALLETS=

# Create a LiveKit Cloud project, then copy its server URL, API key, and secret.
# Keep LIVEKIT_API_SECRET only in Render's secret environment variables.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MAX_ROOM_PARTICIPANTS=8
# The public lounge shown to visitors without a private ?room= invite.
DEFAULT_LIVE_ROOM=juicy-live
